<?xml version="1.0" encoding="utf-8"?>
<!-- Widget «sale del marco» (bocetos/widget-android/tarjeta.html, D): la tarjeta toma el color de la ropa de la
     secretaría y su busto pixel se asoma por arriba. «Escribir» y «Hablar» abren una charla nueva con ella. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- el marco de color ocupa las tres cuartas partes de abajo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="26" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="74">

            <ImageView
                android:id="@+id/w_marco"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/w_marco" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/w_brillo" />
        </FrameLayout>
    </LinearLayout>

    <!-- encima: busto y nombre, y abajo los dos botones -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/w_abrir"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/w_busto"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="58"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no"
                android:scaleType="fitEnd"
                android:src="@mipmap/ic_launcher" />

            <TextView
                android:id="@+id/w_nombre"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="10dp"
                android:layout_weight="42"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="@string/app_name"
                android:textColor="#FFFFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:id="@+id/w_escribir"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/w_boton_trans"
                android:contentDescription="@string/atajo_escribir"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/w_escribir_ico"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/w_lapiz" />

                <TextView
                    android:id="@+id/w_escribir_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:maxLines="1"
                    android:text="@string/widget_escribir"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/w_hablar"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@drawable/w_boton_blanco"
                android:contentDescription="@string/atajo_hablar"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/w_hablar_ico"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/w_mic"
                    android:tint="#FF1D1D1F" />

                <TextView
                    android:id="@+id/w_hablar_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:maxLines="1"
                    android:text="@string/widget_hablar"
                    android:textColor="#FF1D1D1F"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
