{
  "name": "oficina-backend",
  "version": "0.0.0",
  "private": true,
  "description": "Backend de la Oficina en TypeScript: la API que usan la app de escritorio (desktop/) y el modo desarrollo.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "tsc && node dist/src/dev.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "baileys": "7.0.0-rc14",
    "fflate": "^0.8.3",
    "mammoth": "^1.13.0",
    "qrcode": "^1.5.4",
    "unpdf": "^2.2.0"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "4.3.2",
    "ogg-opus-decoder": "1.7.5"
  }
