{
  "name": "oficina",
  "productName": "Oficina",
  "version": "1.13.0",
  "private": true,
  "description": "Oficina: tu oficina de agentes de Claude (Mac y Windows). De acá salen el .dmg y el .exe de las releases.",
  "main": "dist/main.cjs",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "electron-updater": "6.8.11",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "author": "Oficina",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p .",
    "start": "node scripts/build.mjs && electron .",
    "dist:mac": "node scripts/build.mjs --recursos && electron-builder --mac --arm64",
    "dist:win": "node scripts/build.mjs --recursos && electron-builder --win --x64"
  },
  "build": {
    "appId": "com.oficina.app",
    "productName": "Oficina",
    "copyright": "Oficina",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "!dist/**/*.map"
    ],
    "extraResources": [
      {
        "from": "build/recursos/oficina",
        "to": "oficina"
      },
      {
        "from": "build/icon.png",
        "to": "icono.png"
      },
      {
        "from": "build/recursos/transcriptor",
        "to": "transcriptor"
      }
    ],
    "asar": true,
    "npmRebuild": false,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": "-",
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": false,
      "extendInfo": {
        "SUPublicEDKey": "3lXavZJQZAaLrys0ULu1XQD/vj8CLcyxe4NP+QAWsx8=",
        "NSMicrophoneUsageDescription": "Oficina usa el micrófono para que les hables a tus agentes. El audio se transcribe en tu compu."
      }
    },
    "dmg": {
      "artifactName": "Oficina-${version}-arm64.dmg"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "artifactName": "Oficina-Setup-${version}.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Oficina",
      "language": "3082"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "salaesp",
        "repo": "cherry-office",
        "releaseType": "release"
      }
    ],
    "asarUnpack": [
      "dist/whatsapp-captura.mjs"
    ]
  }
}
